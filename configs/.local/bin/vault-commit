#!/usr/bin/env bash
# vault-commit — Obsidian 库 → GitHub 工作流（提交 + 速记）
#
# 供 ii 的 quickshell 弹框和终端共用。所有子命令往 stdout 打**单行 JSON**。
# 注意：输出 ok:false 时退出码通常是 0（用 jq 判 ok 字段，别判退出码）。
#
#   list                     列出配置里的 vault
#   detect                   识别「当前在哪个库」→ {ok, key, name, label} 或 {ok:false, candidates}
#   status <key>             未提交变更摘要（会先 add -A，让摘要 == 将提交的内容）
#   apply <key> <message>    add -A → commit → push；远端有新提交自动 rebase；**没改动时=同步远端**
#   title-prefix             打印速记标题前缀，如 "July 14th, 2026 - "
#   capture <key> <text>     在库里新建 <title-prefix><text>.md 并在 Obsidian 打开
#   interactive [<key>]      提交的 GUI 版（rofi/zenity，无 ii 弹框的机器用）：没改动=顺手同步，结果发通知
#   capture-interactive [<key>]  速记的 GUI 版：收标题后建笔记，结果发通知
#   checkpoint [<key>]       脏才询问的一次性对账（GUI 收 message → apply；干净则静默退出）
#   watch                    常驻哨兵：Obsidian 启停边沿 → 干净拉取 / 脏则询问（systemd 服务用）
#
# 配置：~/.config/vault-commit/vaults.json（可用 VAULT_COMMIT_CONFIG 覆盖）
#   { "mounts": ["/mnt/Storage"], "vaults": [{key,name,label,path}, ...] }
#   · mounts：操作前必须已挂载，防「盘没挂 → add -A 把整库删光」
#   · name 必须与 Obsidian 库的文件夹名一致（窗口标题靠它匹配）
#
# watch 环境变量（均有默认值）：
#   VAULT_COMMIT_OBSIDIAN_PATTERN      进程匹配（默认 "obsidian/app[.]asar"；Fedora flatpak 另配）
#   VAULT_COMMIT_WATCH_POLL            轮询秒（默认 5）
#   VAULT_COMMIT_WATCH_PULL_INTERVAL   运行期干净拉取间隔秒（默认 600；0=关）
#   VAULT_COMMIT_WATCH_PROMPT_COOLDOWN 同库询问冷却秒（默认 600）
#   VAULT_COMMIT_CHECKPOINT_UI         测试注入口：替代 UI 解析直接执行的命令（参数=库 key）

set -uo pipefail

CONFIG="${VAULT_COMMIT_CONFIG:-$HOME/.config/vault-commit/vaults.json}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/vault-commit"
LOCKDIR="${XDG_RUNTIME_DIR:-/tmp}/vault-commit"
OBSIDIAN_JSON="$HOME/.config/obsidian/obsidian.json"
# watch 里要子进程自调用（checkpoint / apply），一律用绝对路径，别依赖 PATH
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

# ── 输出工具 ────────────────────────────────────────────────────────────
emit_err()       { jq -nc --arg e "$1" '{ok:false, error:$e}'; exit 1; }
emit_err_stage() { jq -nc --arg s "$1" --arg e "$2" '{ok:false, stage:$s, error:$e}'; exit 0; }

need_config() {
  [[ -f "$CONFIG" ]] || emit_err "找不到配置文件：$CONFIG"
  command -v jq >/dev/null 2>&1 || emit_err "缺少 jq"
}

check_mounts() {
  local m
  while IFS= read -r m; do
    [[ -n "$m" ]] || continue
    mountpoint -q "$m" || emit_err "挂载点未就绪：$m（磁盘没挂上，拒绝操作）"
  done < <(jq -r '.mounts[]? // empty' "$CONFIG" 2>/dev/null)
}

# ── vault 解析（注意：只在主 shell 里 emit，不要放进 $() 里）────────────
vault_field() { # $1=key $2=field
  jq -r --arg k "$1" --arg f "$2" \
     '.vaults[]? | select(.key==$k) | (.[$f] // "")' "$CONFIG" 2>/dev/null
}

vault_path() { # $1=key → 打路径；失败 return 1 且不输出（供 $() 捕获）
  local p
  p="$(vault_field "$1" path)"
  [[ -n "$p" && "$p" != "null" ]] || return 1
  [[ -d "$p" ]] || return 1
  printf '%s' "$p"
}

# 结果放进全局 VAULT_PATH。**调用处绝不能写成 p="$(require_vault ...)"**——
# 那样 emit_err 的 exit 只会杀掉子 shell，$p 会变成报错 JSON 文本（假成功 bug 的根源）。
VAULT_PATH=""
require_vault() { # $1=key；任何问题在主 shell 里 emit_err 并退出
  VAULT_PATH="$(vault_path "$1")" \
    || emit_err "找不到可用的 vault（key='$1'；路径不存在或 /mnt/Storage 没挂？）"
  git -C "$VAULT_PATH" rev-parse --git-dir >/dev/null 2>&1 \
    || emit_err "不是 git 仓库：$VAULT_PATH"
}

# ── 状态记忆（上次用的库）────────────────────────────────────────────
state_get() { cat "$STATE_DIR/$1" 2>/dev/null; }
state_set() { mkdir -p "$STATE_DIR"; printf '%s' "$2" > "$STATE_DIR/$1"; }

# ── list ────────────────────────────────────────────────────────────────
cmd_list() {
  need_config
  jq -c '{ok:true, vaults:[.vaults[] | {key, name, label, path}]}' "$CONFIG"
}

# ── detect ──────────────────────────────────────────────────────────────
# 判定链：Obsidian 窗口标题 → obsidian.json 的 open（且必须在配置内）→ 上次用的
detect_from_window() {
  local titles t k
  titles="$(hyprctl clients -j 2>/dev/null \
    | jq -r '[.[] | select(((.class // "") | ascii_downcase) | test("obsidian"))]
             | sort_by(.focusHistoryID) | .[].title' 2>/dev/null)" || return 1
  [[ -n "$titles" ]] || return 1
  while IFS= read -r t; do
    [[ -n "$t" ]] || continue
    # 库名按长度降序匹配，避免 "X" 把 "X Notes" 吞掉；标题 = "<笔记名> - <库名>" 或 "<库名>"
    k="$(jq -r --arg t "$t" '
        [.vaults[]?] | sort_by(.name | length) | reverse
        | .[] | select($t == .name or ($t | endswith(" - " + .name))) | .key' "$CONFIG" 2>/dev/null | head -1)"
    if [[ -n "$k" ]]; then printf '%s' "$k"; return 0; fi
  done <<< "$titles"
  return 1
}

detect_from_obsidian_json() {
  local p k
  [[ -f "$OBSIDIAN_JSON" ]] || return 1
  p="$(jq -r '.vaults // {} | to_entries[] | select(.value.open == true) | .value.path' \
        "$OBSIDIAN_JSON" 2>/dev/null | head -1)"
  [[ -n "$p" && "$p" != "null" ]] || return 1
  # 注意：没匹配时必须 return 1。直接以 jq|head 结尾的话，空输出也会因 head 的
  # 退出码 0 被判成「成功」，链条就会在「配置里没有这个库」时误停（见过）。
  k="$(jq -r --arg p "$p" '
      .vaults[]? | select((.path | sub("/+$";"")) == ($p | sub("/+$";""))) | .key' \
    "$CONFIG" 2>/dev/null | head -1)"
  [[ -n "$k" ]] || return 1
  printf '%s' "$k"
}

cmd_detect() {
  need_config
  check_mounts
  local key source=""
  if key="$(detect_from_window)"; then source="window"
  elif key="$(detect_from_obsidian_json)"; then source="obsidian-json"
  elif key="$(state_get last)"; then source="last"
  fi
  if [[ -n "$key" ]]; then
    state_set last "$key"
    jq -nc --arg k "$key" --arg src "$source" \
       --arg n "$(vault_field "$key" name)" --arg l "$(vault_field "$key" label)" \
       '{ok:true, key:$k, name:$n, label:$l, source:$src}'
  else
    jq -nc --argjson c "$(jq -c '[.vaults[]? | {key,name,label}]' "$CONFIG")" \
       '{ok:false, error:"无法确定是哪个库", candidates:$c}'
  fi
}

# ── status ──────────────────────────────────────────────────────────────
# 护栏：整库删除（盘没挂/目录被换空时 add -A 的灾难提交）
guard_mass_deletion() { # $1=path
  local head_count deleted
  head_count="$(git -C "$1" ls-tree -r HEAD --name-only 2>/dev/null | wc -l)"
  deleted="$(git -C "$1" diff --cached --diff-filter=D --name-only | wc -l)"
  if (( head_count > 20 )) && (( deleted * 2 > head_count )); then
    emit_err "疑似整库删除（已 stage 删除 $deleted/$head_count 个文件），已拒绝。确认无误请手动 git commit"
  fi
}

# 护栏：rebase/merge 中途。obsidian-git 自动兜底层碰到冲突时会把仓库留在这种状态
# （「Resolve conflicts and commit manually.」，它不 abort）——此时再 add -A / commit
# 会把冲突现场搅得更乱，故 status/apply/interactive 一律拒绝并指路终端。
# 两种形态（d2 实测 2026-10-10，bench 库里都真出现过）：
#   A) .git/rebase-merge 等目录在位（本地已提交、pull --rebase 重放时撞车）
#   B) 只有未合并索引 + autostash 残留（工作区脏、pull --rebase --autostash 弹回时撞车）
#      —— B 没有 rebase 目录，光查目录会漏！漏掉的话 add -A 会把 <<<<<<< 标记
#      当「已解决」直接提交推送（d2 里真的发生了），所以必须加查 ls-files -u。
guard_mid_operation() { # $1=path
  local p="$1" rel gp kind
  for rel in rebase-merge rebase-apply MERGE_HEAD; do
    gp="$(git -C "$p" rev-parse --git-path "$rel" 2>/dev/null)" || continue
    [[ -n "$gp" ]] || continue
    [[ "$gp" = /* ]] || gp="$p/$gp"   # --git-path 在 git -C 之下输出相对路径
    if [[ -e "$gp" ]]; then
      case "$rel" in
        MERGE_HEAD) kind="merge" ;;
        *)          kind="rebase" ;;
      esac
      emit_err_stage "mid-operation" \
        "仓库正卡在 ${kind} 中途（多半是自动同步碰冲突留下的，它不自动 abort），已拒绝。去终端：cd \"$p\" && git status 看现场；继续 = git ${kind} --continue，放弃 = git ${kind} --abort"
    fi
  done
  # 形态 B：没有 rebase 目录，但索引里留着未合并条目（autostash 弹回冲突的签名）
  if [[ -n "$(git -C "$p" ls-files -u 2>/dev/null)" ]]; then
    emit_err_stage "mid-operation" \
      "仓库有未解决的冲突（多半是自动同步 autostash 弹回的，它留下现场就走），已拒绝。去终端：cd \"$p\" && git status 看冲突文件；改好后 git add <文件> && git commit && git push；若 git stash list 还有 autostash 残留，git stash drop 清掉"
  fi
}

cmd_status() {
  need_config
  check_mounts
  local key="${1:-}" p name label
  require_vault "$key"; p="$VAULT_PATH"
  guard_mid_operation "$p"
  name="$(vault_field "$key" name)"
  label="$(vault_field "$key" label)"

  # 先 add -A：让摘要精确等于「将要提交的内容」（幂等；apply 时会再 add 一次）
  git -C "$p" add -A
  guard_mass_deletion "$p"

  local ahead
  ahead="$(git -C "$p" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"

  if git -C "$p" diff --cached --quiet; then
    jq -nc --arg n "$name" --arg l "$label" --argjson a "${ahead:-0}" \
      '{ok:true, name:$n, label:$l, clean:true, count:0, insertions:0, deletions:0, files:[], ahead:$a}'
    return 0
  fi

  local files ins del
  # -c core.quotePath=false 不能省：默认 git 会把非 ASCII 路径转义成 "\346\214\252..."
  # 的样子（中文文件名全变乱码）。实测踩过。
  files="$(git -C "$p" -c core.quotePath=false status --porcelain \
    | awk '{ s=substr($0,1,2); gsub(/^ +| +$/,"",s); print s "\t" substr($0,4) }' \
    | jq -Rn '[inputs | split("\t") | {status: .[0], path: (.[1:] | join("\t"))}]')"

  read -r ins del < <(git -C "$p" diff --cached --numstat \
    | awk '{ a += ($1 + 0); d += ($2 + 0) } END { printf "%d %d\n", a+0, d+0 }')

  jq -nc --arg n "$name" --arg l "$label" --argjson a "${ahead:-0}" \
     --argjson files "$files" --argjson ins "${ins:-0}" --argjson del "${del:-0}" \
     '{ok:true, name:$n, label:$l, clean:false,
       count:($files|length), insertions:$ins, deletions:$del, files:$files, ahead:$a}'
}

# ── apply ───────────────────────────────────────────────────────────────
run_git_net() { # $1=path 其余=git 参数 → 打输出，带超时与禁交互（防断网吊死）
  local p="$1"; shift
  # 超时可用 $GIT_NET_TIMEOUT 调（默认 90s；「顺手同步」那条路调小到 30s）
  GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND="ssh -o BatchMode=yes -o ConnectTimeout=10" \
    timeout "${GIT_NET_TIMEOUT:-90}" git -C "$p" "$@" 2>&1
}

run_push() { # $1=path 其余=git push 的参数
  local p="$1"; shift
  run_git_net "$p" push "$@"
}

cmd_apply() {
  need_config
  check_mounts
  local key="${1:-}" msg="${2:-}"
  [[ -n "$msg" ]] || emit_err "commit message 不能为空"

  local p; require_vault "$key"; p="$VAULT_PATH"
  guard_mid_operation "$p"

  # 连按两次快捷键时，第二次直接出局
  mkdir -p "$LOCKDIR"
  exec 9>"$LOCKDIR/$key.lock"
  flock -n 9 || emit_err "另一个提交正在进行中，稍等"

  git -C "$p" add -A
  guard_mass_deletion "$p"

  local hash
  if git -C "$p" diff --cached --quiet; then
    # 没有新改动。但可能是「上一轮提交成功了、push 失败了」→ 这时补推一次，
    # 否则用户重试只会一直被告知「没有需要提交的改动」，永远推不上去。
    if ! git -C "$p" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
      emit_err_stage "no-changes" "没有需要提交的改动"
    fi
    if [[ "$(git -C "$p" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)" == "0" ]]; then
      # 「顺手同步」：干净且不领先 → 把另一台机器推的拉下来。
      # 双机并用的读路径（坐下来只想看另一台昨晚写的东西）；按 G/回车也是走这里。
      local before after n pout
      before="$(git -C "$p" rev-parse HEAD 2>/dev/null)"
      if pout="$(GIT_NET_TIMEOUT=30 run_git_net "$p" pull --rebase)"; then
        after="$(git -C "$p" rev-parse HEAD 2>/dev/null)"
        n="$(git -C "$p" rev-list --count "$before..$after" 2>/dev/null || echo 0)"
        if [[ "${n:-0}" == "0" ]]; then
          emit_err_stage "no-changes" "没有需要提交的改动（远端也是最新的）"
        else
          emit_err_stage "no-changes" "没有需要提交的改动 · 已从另一台同步 $n 个提交"
        fi
      else
        emit_err_stage "pull" "没有需要提交的改动，但同步远端失败：${pout:-无输出}"
      fi
    fi
  else
    local out
    if ! out="$(git -C "$p" commit -m "$msg" 2>&1)"; then
      emit_err_stage "commit" "$out"
    fi
  fi

  hash="$(git -C "$p" rev-parse --short HEAD)"

  # push：带 90s 超时（断网/代理挂掉时 git 会吊死，弹框会永远停在「推送中」）
  local perr rc=0
  perr="$(run_push "$p")" || rc=$?
  if (( rc != 0 )); then
    if ! git -C "$p" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
      # 没有 upstream 的仓库（新建分支/首次推送）——补一次 -u。
      # ⚠️ 重试前 rc 必须先归零：重试成功时 `|| rc=$?` 不执行，rc 会留着上一次的失败码
      # → 明明推成功了却报「推送失败」（实测踩过）。
      rc=0
      perr="$(run_push "$p" -u origin HEAD)" || rc=$?
    elif grep -qiE "non-fast-forward|fetch first|\[rejected\]" <<< "$perr"; then
      # 远端有新提交（多半是另一台机器推的）→ rebase 到远端之上再重推。
      # 双机并用（Arch 晚上写 / Fedora 白天写）的核心路径。
      local preb
      if preb="$(run_git_net "$p" pull --rebase)"; then
        rc=0
        perr="$(run_push "$p")" || rc=$?
      elif [[ -d "$p/.git/rebase-merge" || -d "$p/.git/rebase-apply" ]]; then
        # 两边改了同一处 → 停在中途。abort 保持干净（本地提交还在），让用户手动解决
        git -C "$p" rebase --abort >/dev/null 2>&1
        jq -nc --arg h "$hash" --arg path "$p" \
          '{ok:false, stage:"conflict", hash:$h,
            error:("另一台机器的改动与本地冲突，已停止（你的提交还在本地 " + $h + "）。"
                   + "去终端执行：cd \"" + $path + "\" && git pull --rebase 手动解决后重试")}'
        return 0
      else
        jq -nc --arg h "$hash" --arg e "${preb:-拉取失败（无输出）}" \
          '{ok:false, stage:"pull", hash:$h,
            error:("提交已在本地（" + $h + "），但同步远端失败：" + $e)}'
        return 0
      fi
    fi
  fi
  if (( rc == 124 )); then perr="推送超时（90 秒无响应，检查网络/代理）"; fi
  if (( rc != 0 )); then
    jq -nc --arg h "$hash" --arg e "${perr:-推送失败（无输出）}" \
      '{ok:false, stage:"push", hash:$h,
        error:("提交已在本地（" + $h + "），但推送失败：" + $e)}'
    return 0
  fi

  state_set last "$key"
  jq -nc --arg h "$hash" --arg n "$(vault_field "$key" name)" \
    '{ok:true, stage:"pushed", hash:$h, name:$n}'
}

# ── 速记：新建笔记 ──────────────────────────────────────────────────────
ordinal() {
  case "$1" in
    11|12|13) printf '%s' "${1}th" ;;
    *1)       printf '%s' "${1}st" ;;
    *2)       printf '%s' "${1}nd" ;;
    *3)       printf '%s' "${1}rd" ;;
    *)        printf '%s' "${1}th" ;;
  esac
}

cmd_title_prefix() {
  # LC_TIME=C 保证月份是英文（否则中文 locale 下会出「七月」）
  local day mon
  day="$(LC_TIME=C date +%-d)"
  mon="$(LC_TIME=C date +%B)"
  printf '%s %s, %s - \n' "$mon" "$(ordinal "$day")" "$(LC_TIME=C date +%Y)"
}

cmd_capture() {
  need_config
  check_mounts
  local key="${1:-}" text="${2:-}"
  [[ -n "$text" ]] || emit_err "标题内容不能为空"

  local p; require_vault "$key"; p="$VAULT_PATH"

  local prefix title file
  prefix="$(cmd_title_prefix)"
  # 前端预填了前缀 → 不重复叠加
  if [[ "$text" == "$prefix"* ]]; then title="$text"; else title="${prefix}${text}"; fi
  # 去掉 Obsidian 不接受的文件名字符，并掐掉尾部空白
  title="$(printf '%s' "$title" | tr -d '\\/:*?"<>|' | sed 's/[[:space:]]*$//')"
  [[ -n "$title" ]] || emit_err "标题清洗后为空"

  file="$p/$title.md"
  [[ -e "$file" ]] && emit_err "同名笔记已存在：$title.md"

  : > "$file" || emit_err "创建失败：$file"

  # 在 Obsidian 里打开（新文件也能按绝对路径解析）。fire-and-forget，两个坑缺一不可
  # （2026-10-11 事故的教训）：
  #  · 不许前台等 —— Obsidian 本来没开时，xdg-open 启动的 electron 就是 App 主进程、
  #    永不退出；前台等它 = 脚本永不返回 → ii 弹框永远 busy（之后 G/S 全静默失灵）
  #  · 后台也得重定向 —— 子进程要是接着攥住 stdout，QML 的 StdioCollector 等 EOF 会一直等
  local uri="obsidian://open?path=$(jq -rn --arg s "$file" '$s|@uri')"
  local opener=xdg-open
  command -v xdg-open >/dev/null 2>&1 || opener=obsidian
  ( "$opener" "$uri" </dev/null >/dev/null 2>&1 & ) || true

  state_set last "$key"
  jq -nc --arg t "$title" --arg f "$file" --arg u "$uri" \
    '{ok:true, title:$t, file:$f, uri:$u}'
}

# ── interactive（无 ii 弹框的机器：Arch 上是兜底，Fedora/GNOME 是主力）──
# rofi 优先，没有就用 zenity（GNOME 自带，零安装）

need_gui() {
  command -v rofi >/dev/null 2>&1 || command -v zenity >/dev/null 2>&1 \
    || emit_err "需要 rofi 或 zenity 来收输入"
}

gui_ask() { # $1=标题 $2=提示文字 → 打印用户输入
  if command -v rofi >/dev/null 2>&1; then
    printf '' | rofi -dmenu -p "$1" -mesg "$2"
  else
    zenity --entry --title="$1" --text="$2" --width=420
  fi
}

gui_pick() { # $1=标题 其余=候选项 → 打印选中项
  local prompt="$1"; shift
  if command -v rofi >/dev/null 2>&1; then
    printf '%s\n' "$@" | rofi -dmenu -i -p "$prompt"
  else
    zenity --list --title="$prompt" --column="选择" --width=440 --height=280 "$@"
  fi
}

# 认不出库时弹选择器；选不动就返回 1
pick_vault_key() { # $1=提示语 → 打印 key
  local choices=() choice
  mapfile -t choices < <(jq -r '.vaults[]? | "\(.label)  (\(.name))"' "$CONFIG")
  choice="$(gui_pick "$1" "${choices[@]}")" || return 1
  [[ -n "$choice" ]] || return 1
  jq -r --arg c "$choice" \
    '.vaults[]? | select(("\(.label)  (\(.name))") == $c) | .key' "$CONFIG" | head -1
}

# 结果 → 桌面通知。给没有 quickshell 弹框的机器用（GNOME 快捷键的 stdout 是死的，
# 不通知的话成功/失败都看不见）。没有 notify-send 就静默跳过。
notify_result() { # $1=JSON
  command -v notify-send >/dev/null 2>&1 || return 0
  local ok stage
  ok="$(jq -r '.ok // false' <<< "$1" 2>/dev/null)"
  stage="$(jq -r '.stage // ""' <<< "$1" 2>/dev/null)"
  if [[ "$ok" == "true" ]]; then
    local body
    if [[ "$stage" == "pushed" ]]; then
      body="已提交并推送（$(jq -r '.hash // ""' <<< "$1")）"
    else
      body="$(jq -r '.title // .name // "完成"' <<< "$1")"
    fi
    notify-send -a vault-commit "笔记" "$body"
  elif [[ "$stage" == "no-changes" ]]; then
    notify-send -a vault-commit "笔记" "$(jq -r '.error // "没有需要提交的改动"' <<< "$1")"
  else
    notify-send -u critical -a vault-commit "笔记：没成功" "$(jq -r '.error // "未知错误"' <<< "$1")"
  fi
}

cmd_interactive() {
  need_config
  check_mounts
  need_gui
  local key="${1:-}" msg st out

  # 认库：跟速记同一条链（GNOME 上没有 hyprctl，自然落到 obsidian.json）
  if [[ -z "$key" ]]; then
    if ! key="$(detect_from_window)"; then
      if ! key="$(detect_from_obsidian_json)"; then
        key="$(state_get last)"
      fi
    fi
  fi
  if [[ -z "$key" ]]; then
    key="$(pick_vault_key "提交哪个库")" || exit 1
    [[ -n "$key" ]] || exit 1
  fi

  # 没有改动就不问 message：按一下 = 顺手同步（cmd_apply 的「无改动」分支会拉远端）
  st="$(cmd_status "$key" 2>/dev/null)"
  # status 直接失败（mid-operation / 挂载点没了等）：把真实错误亮出来，别骗用户先写 message
  # ⚠️ 不能写 .ok // true：jq 的 // 把 false 也当空值 → 永远得到 true（踩过）
  if [[ "$(jq -r '.ok == false' <<< "$st" 2>/dev/null)" == "true" ]]; then
    printf '%s\n' "$st"
    notify_result "$st"
    exit 0
  fi
  if [[ "$(jq -r '.clean' <<< "$st" 2>/dev/null)" == "true" ]]; then
    msg="（同步）"
  else
    msg="$(gui_ask "commit message" "库：$key")" || exit 1
    [[ -n "$msg" ]] || { echo "已取消（message 为空）" >&2; exit 1; }
  fi

  out="$(cmd_apply "$key" "$msg")"
  printf '%s\n' "$out"
  notify_result "$out"
}

cmd_capture_interactive() {
  need_config
  check_mounts
  need_gui
  local key="${1:-}" text out

  # 认库：跟 detect 同一条链，只是静默（GNOME 上没有 hyprctl，自然会落到 obsidian.json）
  if [[ -z "$key" ]]; then
    if ! key="$(detect_from_window)"; then
      if ! key="$(detect_from_obsidian_json)"; then
        key="$(state_get last)"
      fi
    fi
  fi
  if [[ -z "$key" ]]; then
    key="$(pick_vault_key "写到哪个库")" || exit 1
    [[ -n "$key" ]] || exit 1
  fi

  text="$(gui_ask "笔记标题" "会存成「$(cmd_title_prefix | tr -d '\n')<你写的>」")" || exit 1
  [[ -n "$text" ]] || { echo "已取消（标题为空）" >&2; exit 1; }

  out="$(cmd_capture "$key" "$text")"
  printf '%s\n' "$out"
  notify_result "$out"
}

# ── watch：会话边界同步哨兵（2026-10-11 第八轮）──────────────────────────
# 与 obsidian-git 自动层的区别：**绝不自动提交**。同步点钉在 Obsidian 的会话边界：
#   启动边沿：干净 → 静默对账（落后就拉 / 领先就补推）；脏 → 询问；冲突现场 → 只提醒
#   退出边沿：脏 → 询问（用户要的「关闭时检查」）；干净 → 静默对账（离开前结算）
#   运行中每 VAULT_COMMIT_WATCH_PULL_INTERVAL 秒：干净才拉（脏绝不碰）
# 两机编辑窗口不重叠 + 非重叠 rebase → 从结构上消灭手动解冲突。
#
# ⚠️ safe_pull / raise_checkpoint 必须经 $() 或 & 在**子壳**里跑：
#   · 子壳里 exec 出来的锁 fd 随子壳消亡。反例：cmd_apply 的 `exec 9>` 若在守护进程
#     主 shell 里执行，锁会被永久攥住 → 手动 G 永远「另一个提交正在进行中」（审校抓的）
#   · 子壳里 emit_err 的 exit 也只杀子壳，带不走守护进程

WATCH_LOG_PREFIX="[vault-commit watch]"
log() { printf '%s %s\n' "$WATCH_LOG_PREFIX" "$*" >&2; }  # stderr→journal；stdout 留给结果 token

# 只读净查（GIT_OPTIONAL_LOCKS=0：不写 index，不与前台 git 抢 index.lock）
is_clean() { # $1=path
  [[ -z "$(GIT_OPTIONAL_LOCKS=0 git -C "$1" status --porcelain 2>/dev/null)" ]]
}

# 中途现场（A: rebase/merge 目录在 | B: ls-files -u 未合并索引）——只读版，判据同 guard_mid_operation
is_mid_operation() { # $1=path；有现场返回 0
  local p="$1" rel gp
  for rel in rebase-merge rebase-apply MERGE_HEAD; do
    gp="$(git -C "$p" rev-parse --git-path "$rel" 2>/dev/null)" || continue
    [[ -n "$gp" ]] || continue
    [[ "$gp" = /* ]] || gp="$p/$gp"
    [[ -e "$gp" ]] && return 0
  done
  [[ -n "$(git -C "$p" ls-files -u 2>/dev/null)" ]] && return 0
  return 1
}

# 冷却（state 目录里的 epoch 时间戳文件，tag 里的怪字符换掉）
cool_ok() { # $1=tag $2=秒 → 0=已过冷却
  local f last now
  f="$STATE_DIR/watch.cool.$(printf '%s' "$1" | tr -c 'a-zA-Z0-9._-' '_')"
  last="$(cat "$f" 2>/dev/null || echo 0)"; now="$(date +%s)"
  (( now - last >= ${2:-600} ))
}
mark_cool() {
  local f
  f="$STATE_DIR/watch.cool.$(printf '%s' "$1" | tr -c 'a-zA-Z0-9._-' '_')"
  mkdir -p "$STATE_DIR"; date +%s > "$f"
}

obsidian_running() { pgrep -f "${VAULT_COMMIT_OBSIDIAN_PATTERN:-obsidian/app[.]asar}" >/dev/null 2>&1; }

# 通知（notify-send 失败/缺席要在 journal 里留痕，否则「哨兵活着但一声不吭」没法排查）
vnotify() { # $1=标题 $2=正文
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a vault-commit "$1" "$2" 2>/dev/null || log "notify-send 失败：$1 / $2"
  else
    log "无 notify-send，通知丢弃：$1 / $2"
  fi
}

# ── hypr 面板可用性 ─────────────────────────────────────────────────────
# 实例动态解析：systemd 里的 HYPRLAND_INSTANCE_SIGNATURE 在 Hyprland 重启后是陈旧的；
# `hyprctl -j instances` 不依赖环境变量（实测给 bogus env 也照常输出），取 time 最大者为当前实例。
# 顺带拿 wl_socket，给降级 GUI（rofi/zenity）当 WAYLAND_DISPLAY 用。
HYPR_SIG=""; HYPR_WL=""
hypr_probe() {
  HYPR_SIG=""; HYPR_WL=""
  command -v hyprctl >/dev/null 2>&1 || return 1
  local j
  j="$(hyprctl -j instances 2>/dev/null)" || return 1
  HYPR_SIG="$(jq -r 'max_by(.time).instance // empty' <<< "$j" 2>/dev/null)"
  HYPR_WL="$(jq -r 'max_by(.time).wl_socket // empty' <<< "$j" 2>/dev/null)"
  [[ -n "$HYPR_SIG" ]]
}

# 0=可用；1=用不了面板（走 GUI/通知降级）；2=锁屏中；3=全屏中（2/3 会把询问挂起待发）
can_use_panel() {
  hypr_probe || return 1
  hyprctl -i "$HYPR_SIG" globalshortcuts 2>/dev/null | grep -q 'quickshell:vaultCommitOpen' || return 1
  # 面板已开着就别 dispatch：openAndDetect() 会清空用户正在写的 message（VaultCommit.qml:103）
  if hyprctl -i "$HYPR_SIG" -j layers 2>/dev/null \
       | jq -e 'any(.. | objects | .namespace? // empty; . == "quickshell:vaultCommit")' >/dev/null 2>&1; then
    return 1
  fi
  pgrep -x hyprlock >/dev/null 2>&1 && return 2
  local fs
  fs="$(hyprctl -i "$HYPR_SIG" -j activewindow 2>/dev/null | jq -r '.fullscreen // 0' 2>/dev/null)"
  [[ "${fs:-0}" == "0" ]] || return 3
  return 0
}

# ── safe_pull：干净库对账（落后→拉，领先→补推，双分歧→rebase 后重推）──
# **绝不 add/commit**（脏一律 skip）→ 结构上杜绝「把半写的笔记卷进提交」和 autostash 式冲突。
# 输出单行 token：pulled:<n> | pushed:<n> | noop | skip:* | warn:* | conflict
# ⚠️ 调用处必须 $() 捕获（子壳运行）——fd 9 锁随子壳释放，绝不泄漏进守护进程。
safe_pull() { # $1=key
  local key="$1" p
  p="$(vault_path "$key")" || { echo "skip:no-path"; return 0; }
  is_mid_operation "$p" && { echo "skip:mid-op"; return 0; }
  mkdir -p "$LOCKDIR"
  exec 9>"$LOCKDIR/$key.lock"
  flock -n 9 || { echo "skip:locked"; return 0; }   # 与手动 G 同一把锁：抢不到就跳过
  is_clean "$p" || { echo "skip:dirty"; return 0; }
  local ahead out out2 before after n
  ahead="$(git -C "$p" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
  if (( ahead > 0 )); then
    # 干净但领先 = 上次 push 没成（断网/代理）→ 补推自愈
    out="$(GIT_NET_TIMEOUT=30 run_push "$p")" && { echo "pushed:$ahead"; return 0; }
    if grep -qiE "non-fast-forward|fetch first|\[rejected\]" <<< "$out"; then
      # 两边都动了：干净树先 rebase 再重推（与 apply 同策略）
      if out2="$(GIT_NET_TIMEOUT=30 run_git_net "$p" pull --rebase)"; then
        if out="$(GIT_NET_TIMEOUT=30 run_push "$p")"; then echo "pushed:$ahead"; else echo "warn:push-failed"; fi
      elif is_mid_operation "$p"; then
        echo "conflict"
      else
        echo "warn:pull-failed"
      fi
    else
      echo "warn:push-failed"
    fi
    return 0
  fi
  before="$(git -C "$p" rev-parse HEAD 2>/dev/null)"
  if out="$(GIT_NET_TIMEOUT=30 run_git_net "$p" pull --rebase)"; then
    after="$(git -C "$p" rev-parse HEAD 2>/dev/null)"
    n="$(git -C "$p" rev-list --count "$before..$after" 2>/dev/null || echo 0)"
    if [[ "${n:-0}" == "0" ]]; then echo "noop"; else echo "pulled:$n"; fi
  else
    echo "warn:pull-failed"
  fi
  return 0
}

# 冲突现场提醒（带冷却；只提醒，绝不碰 git、绝不弹面板）
notify_conflict() { # $1=key
  cool_ok "conflict:$1" 21600 || return 0
  mark_cool "conflict:$1"
  vnotify "笔记：仓库卡在冲突中途" "「$(vault_field "$1" label)」的仓库卡在 rebase/合并中途，去终端解决（cd 到库目录先 git status）"
}

# 面板路径处理了 $1 之后，若其余库也脏，补一条通知（面板一次只处理一个库）
raise_others_notice() { # $1=已处理的 key
  local k q others=""
  while IFS= read -r k; do
    [[ -n "$k" && "$k" != "$1" ]] || continue
    q="$(vault_path "$k")" || continue
    is_clean "$q" || others="$others「$(vault_field "$k" label)」"
  done < <(jq -r '.vaults[]?.key' "$CONFIG" 2>/dev/null)
  [[ -n "$others" ]] && vnotify "笔记：还有别的库没提交" "$others 也有未提交改动（Super+Alt+G 可切库）"
  return 0
}

# ── raise_checkpoint：弹「要不要提交」询问（全异步，不阻塞哨兵循环）──────
# 降级链：测试注入口 → ii 面板 dispatch → GUI 流（rofi/zenity 收 message + apply）→ 通知。
# ask.lock 防叠问；锁屏/全屏挂起到 watch.pending，条件恢复后由 check_pending 补发。
raise_checkpoint() { # $1=key
  local key="$1"
  cool_ok "ask:$key" "${VAULT_COMMIT_WATCH_PROMPT_COOLDOWN:-600}" || { log "询问冷却中，跳过（$key）"; return 0; }
  mkdir -p "$LOCKDIR" "$STATE_DIR"
  (
    exec 5>"$LOCKDIR/ask.lock"
    flock -n 5 || exit 0                       # 已有询问在进行：防叠问
    local p
    p="$(vault_path "$key")" || exit 0
    is_mid_operation "$p" && exit 0            # 冲突现场交给 critical 通知通道，不弹
    is_clean "$p" && exit 0                    # 冷却期间可能已被手动提交

    # 测试注入口：给什么跑什么（参数=key）
    if [[ -n "${VAULT_COMMIT_CHECKPOINT_UI:-}" ]]; then
      mark_cool "ask:$key"
      "$VAULT_COMMIT_CHECKPOINT_UI" "$key" </dev/null >/dev/null 2>&1
      exit 0
    fi

    local rc=0
    can_use_panel || rc=$?
    if (( rc == 0 )); then
      if hyprctl -i "$HYPR_SIG" dispatch 'hl.dsp.global("quickshell:vaultCommitOpen")' 2>/dev/null | grep -q '^ok'; then
        mark_cool "ask:$key"
        log "已唤起 ii 面板询问（$key）"
        raise_others_notice "$key"
        exit 0
      fi
      log "面板 dispatch 未成功，降级 GUI/通知（$key）"
    elif (( rc == 2 || rc == 3 )); then
      # 锁屏/全屏：不打扰，攒到条件恢复后再发。**此处绝不能 mark_cool**——
      # 挂起不是一次「已打扰」，烧掉冷却的话 check_pending 解锁后补发会被自己拦下
      log "锁屏/全屏中，询问挂起（$key）"
      state_set watch.pending "$(echo $(state_get watch.pending) "$key")"
      exit 0
    fi

    mark_cool "ask:$key"
    if command -v rofi >/dev/null 2>&1 || command -v zenity >/dev/null 2>&1; then
      # 降级 GUI 从 systemd 拉起时没有 WAYLAND_DISPLAY，用 hypr 的 wl_socket 补上
      [[ -n "$HYPR_WL" && -z "${WAYLAND_DISPLAY:-}" ]] && export WAYLAND_DISPLAY="$HYPR_WL"
      "$SELF" checkpoint "$key" </dev/null >/dev/null 2>&1
    else
      vnotify "笔记：有未提交的改动" "「$(vault_field "$key" label)」有未提交的改动（按 Super+Alt+G 提交）"
    fi
    raise_others_notice "$key"
  ) </dev/null >/dev/null &   # 注意：stderr 保留 → log 进 journal
}

# ── 边沿动作 ────────────────────────────────────────────────────────────
# 启动/退出边沿行为相同：干净→静默对账；脏→问；冲突现场→只提醒
reconcile_edge() { # $1=边沿名（日志用）
  local edge="$1" k p r n
  while IFS= read -r k; do
    p="$(vault_path "$k")" || { log "$edge：$k 路径不可用，跳过"; continue; }
    if is_mid_operation "$p"; then
      notify_conflict "$k"
    elif is_clean "$p"; then
      r="$(safe_pull "$k")"
      case "$r" in
        pulled:*) n="${r#pulled:}"; (( n > 0 )) && vnotify "笔记已同步" "「$(vault_field "$k" label)」从另一台拉到了 $n 个提交";;
        pushed:*) vnotify "笔记已补推" "「$(vault_field "$k" label)」把 ${r#pushed:} 个提交补推上去了";;
        conflict) notify_conflict "$k" ;;
        *) log "$edge：$k → safe_pull $r" ;;
      esac
    else
      log "$edge：$k 有未提交改动 → 询问"
      raise_checkpoint "$k"
    fi
  done < <(jq -r '.vaults[]?.key' "$CONFIG" 2>/dev/null)
  return 0
}

# 运行期定时拉取：只碰干净的库（用户正在编辑时绝不介入）
on_periodic_pull() {
  local k p r n
  while IFS= read -r k; do
    p="$(vault_path "$k")" || continue
    is_mid_operation "$p" && continue
    is_clean "$p" || continue
    r="$(safe_pull "$k")"
    case "$r" in
      pulled:*) n="${r#pulled:}"; (( n > 0 )) && vnotify "笔记已同步" "「$(vault_field "$k" label)」从另一台拉到了 $n 个提交";;
      pushed:*) vnotify "笔记已补推" "「$(vault_field "$k" label)」把 ${r#pushed:} 个提交补推上去了";;
      conflict) notify_conflict "$k" ;;
      *) : ;;
    esac
  done < <(jq -r '.vaults[]?.key' "$CONFIG" 2>/dev/null)
  return 0
}

# 挂起的询问（锁屏/全屏期间攒下的）：面板条件恢复后补发
check_pending() {
  local pending k
  pending="$(state_get watch.pending)"
  [[ -n "$pending" ]] || return 0
  can_use_panel || return 0                    # 还不可用就继续挂
  state_set watch.pending ""
  for k in $(echo $pending | tr ' ' '\n' | sort -u); do raise_checkpoint "$k"; done
  return 0
}

# ── cmd_watch：哨兵主循环 ───────────────────────────────────────────────
cmd_watch() {
  [[ -f "$CONFIG" ]] || { log "找不到配置文件：$CONFIG（跳过）"; exit 0; }
  command -v jq >/dev/null 2>&1 || { log "缺少 jq"; exit 2; }
  mkdir -p "$LOCKDIR" "$STATE_DIR"
  # 单实例：unit 和手动跑同时会开两个哨兵（双份通知/双份拉取）。第二个静默退出
  # （exit 0 → 不触发 Restart；这就是 unit 用 Restart=on-failure 的原因）
  exec 8>"$LOCKDIR/watch.lock"
  flock -n 8 || { log "另一个 watch 已在运行，退出"; exit 0; }
  trap 'log "收到终止信号，退出"; exit 0' TERM INT

  local poll="${VAULT_COMMIT_WATCH_POLL:-${VAULT_COMMIT_WATCH_INTERVAL:-5}}"
  local pull_ivl="${VAULT_COMMIT_WATCH_PULL_INTERVAL:-600}"
  local prev cur last_pull now
  prev="$(state_get watch.obsidian)"
  cur=0; obsidian_running && cur=1
  if [[ -z "$prev" ]]; then
    # 首次安装/状态被清：只记基线，不发边沿（防服务重启误触发）
    log "首次运行：记录基线 obsidian=$cur（不发边沿）"
    state_set watch.obsidian "$cur"; prev="$cur"
  elif [[ "$prev" == "1" && "$cur" == "0" ]]; then
    # 哨兵没盯着的时候 Obsidian 已经关了（关机/重登/服务停过）→ 补一次退出结算（对账）
    log "启动时发现 Obsidian 已不在（期间退出未结算）"
    state_set watch.obsidian 0; prev=0
    reconcile_edge "退出边沿(补)"
  fi
  last_pull="$(date +%s)"
  log "哨兵启动：poll=${poll}s pull=${pull_ivl}s pattern=${VAULT_COMMIT_OBSIDIAN_PATTERN:-obsidian/app[.]asar}"
  while :; do
    cur=0; obsidian_running && cur=1
    if [[ "$cur" != "$prev" ]]; then
      log "obsidian: $prev → $cur"
      state_set watch.obsidian "$cur"
      if [[ "$cur" == "1" ]]; then reconcile_edge "启动边沿"; else reconcile_edge "退出边沿"; fi
      prev="$cur"
    fi
    check_pending
    if [[ "$cur" == "1" && "$pull_ivl" -gt 0 ]]; then
      now="$(date +%s)"
      (( now < last_pull )) && last_pull="$now"          # 时钟回拨钳制
      if (( now - last_pull >= pull_ivl )); then
        log "运行期对账（距上次 $(( now - last_pull ))s）"
        on_periodic_pull
        last_pull="$now"
      fi
    fi
    sleep "$poll" || break
  done
  log "循环退出"
}

# ── checkpoint：一次性对账（watch 的降级 GUI 流；手动也能跑）──────────────
# 认库（缺省）→ 中途现场拒绝 → 脏才问（rofi/zenity 收 message）→ apply → 通知。
# 干净则静默退出，方便被 watch 无脑调用。
cmd_checkpoint() {
  need_config
  check_mounts
  local key="${1:-}"
  if [[ -z "$key" ]]; then
    if ! key="$(detect_from_window)"; then
      if ! key="$(detect_from_obsidian_json)"; then
        key="$(state_get last)"
      fi
    fi
  fi
  local p; require_vault "$key"; p="$VAULT_PATH"
  guard_mid_operation "$p"
  local n
  n="$(GIT_OPTIONAL_LOCKS=0 git -C "$p" status --porcelain 2>/dev/null | wc -l)"
  if (( n == 0 )); then
    # 干净：没得问。领先的提交留给 apply 的「顺手同步」路径补推（下面 msg=（同步））
    if [[ "$(git -C "$p" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)" == "0" ]]; then
      jq -nc '{ok:true, stage:"no-changes", error:"没有未提交的改动"}'
      return 0
    fi
  fi
  need_gui
  local msg out
  if (( n == 0 )); then
    msg="（同步）"
  else
    msg="$(gui_ask "提交笔记改动？" "「$(vault_field "$key" label)」有 $n 处未提交改动。写一句 message 回车提交；留空 / Esc = 先不提交")" \
      || { jq -nc '{ok:false, stage:"cancelled", error:"已放弃（未提交）"}'; return 0; }
    [[ -n "$msg" ]] || { jq -nc '{ok:false, stage:"cancelled", error:"已放弃（未提交）"}'; return 0; }
  fi
  out="$("$SELF" apply "$key" "$msg" 2>&1)"
  printf '%s\n' "$out"
  notify_result "$out"
}

# ── 入口 ────────────────────────────────────────────────────────────────
case "${1:-}" in
  list)         cmd_list ;;
  detect)       cmd_detect ;;
  status)       cmd_status "${2:-}" ;;
  apply)        cmd_apply "${2:-}" "${3:-}" ;;
  title-prefix) cmd_title_prefix ;;
  capture)      cmd_capture "${2:-}" "${3:-}" ;;
  interactive)  cmd_interactive "${2:-}" ;;
  capture-interactive|capture-i) cmd_capture_interactive "${2:-}" ;;
  checkpoint)   cmd_checkpoint "${2:-}" ;;
  watch)        cmd_watch ;;
  ""|-h|--help) sed -n '2,28p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) emit_err "未知子命令：$1（可用：list / detect / status / apply / title-prefix / capture / interactive / capture-interactive / checkpoint / watch）" ;;
esac
