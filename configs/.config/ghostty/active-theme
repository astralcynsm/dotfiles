# 由 matugen 生成，请勿手改
# 模板源: ~/.config/matugen/templates/ghostty/dark
#
# ★ ghostty 的 theme 文件是**单模式**的（不像 foot 有 [colors-dark]/[colors-light] 段），
#   所以明暗必须分成两个模板、两个产物。本文件是深色那一份。
#   浅色那一份见同目录的 light。
#
# ★ 本文件不会自动生效。ghostty 真正读的是 active-theme：
#     matugen 配色: cp themes/matugen-dark  active-theme
#     固定配色:     cp themes/matugen-light active-theme
#   正常由 ~/.config/theme-switcher/switch.sh 的 sync_ghostty_matugen() 按
#   当前主题的明暗自动完成，不需要手工 cp。
#
# ⚠⚠ 绝对不要在这里写行尾注释。ghostty 只把**行首**的 # 当注释。
#
#   实测（Ghostty 1.3.1-arch2，2026-10-08）：
#     源文件:  palette = 0=#1f1f28  # black
#     解析后:  该行**整个消失** —— 不是值被污染，是整行被丢弃。
#     而且 `ghostty +show-config` 退出码 0、stderr 一个字都没有。
#
#   也就是说这是个**完全静默**的失败：配色少一项，你不会收到任何提示，
#   只会在某天发现终端里某类文字颜色不对。
#
#   这是从 foot 模板翻译过来时最容易踩的一脚 —— foot 的 ini 允许行尾注释，
#   templates/foot/foot_theme.ini 里就满篇都是（`regular0=...  # black`）。
#   照抄过来就中招。本目录的两份模板已全部改成注释另起一行。
#
#   验证手段（改完模板务必跑一次）：
#     XDG_CONFIG_HOME=/tmp/xxx ghostty +show-config --changes-only | grep '^palette = 0='
#
# ⚠ background-opacity 刻意与 foot 的 alpha= 无关。
#   foot 的 alpha 是叠在背景色上的 alpha 通道；ghostty 的 background-opacity
#   是独立的乘数，两者不等价。这里取的是用户手工维护的 ghostty 深色主题里
#   那个值（themes/dark = 0.7），保证和现状视觉一致。想改就改这一行。

background = #0f1417
foreground = #dee3e6
background-opacity = 0.7

# 选中文本
selection-background = #004d62
selection-foreground = #bbe9ff

# 光标
cursor-color = #8ad0ee
cursor-text = #0f1417

# --- Normal colors (palette 0-7) ---
# 配色语义逐条对齐 foot 模板 templates/foot/foot_theme.ini，两个终端观感一致
palette = 0=#303638
palette = 1=#ffb4ab
palette = 2=#8ad0ee
palette = 3=#c5c3ea
palette = 4=#8ad0ee
palette = 5=#b4cad5
palette = 6=#c5c3ea
palette = 7=#c0c8cc

# --- Bright colors (palette 8-15) ---
palette = 8=#8a9296
palette = 9=#ffb4ab
palette = 10=#bbe9ff
palette = 11=#e2dfff
palette = 12=#bbe9ff
palette = 13=#cfe6f1
palette = 14=#e2dfff
palette = 15=#dee3e6
