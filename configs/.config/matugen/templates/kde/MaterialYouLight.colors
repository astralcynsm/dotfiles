# ---- 由 matugen 生成，请勿手改 ----
# 模板源: ~/.config/matugen/templates/kde/MaterialYouLight.colors
# 输出:   ~/.local/share/color-schemes/MaterialYouLight.colors
#
# 这是 KDE 配色方案（Color Scheme），Dolphin 及所有 KDE 应用读它。
# 由主题切换器 switch.sh 调 `matugen image <壁纸> --mode <模式>` 时自动生成，
# 挂在 ~/.config/matugen/config.toml 的 [templates.kde_light] 下。
#
# 为什么明暗各写一份、且钉死 .dark / .light 后缀：
#   KDE 不像 fcitx5 那样自带"按系统 color-scheme 自动选主题"的机制。
#   它只有一个值：~/.config/kdeglobals 的 [General] ColorScheme=。
#   所以必须两套方案并存于磁盘，由 switch.sh 改写 kdeglobals 来选。
#   用 .default 会让两份文件在切明暗时互相覆盖。
#   （实测：即使带 --mode 跑，本文件里的取值也只认后缀，不受 --mode 影响）
#
# 配色取舍，与 rofi / fcitx5 候选框保持一致：
#   · 强调色用 primary，大面积容器色用 *_container 系
#   · 选中项用 primary_container / on_primary_container —— 这一组本就是
#     为"容器"设计的，明暗下对比度都够；直接用 primary 在浅色模式下会刺眼
#   · M3 调色板里没有绿色，KDE 却硬性要求一个 ForegroundPositive（成功/确认态）。
#     这里给它 secondary（柔和的辅助色），换来整套配色的和谐；
#     副作用是"成功"语义不如纯绿直观，但该色在 Dolphin 里出现频率极低。
#
# [WM] 段的格式是 #AARRGGBB（原文件 activeBackground=#ff3b3030），
# 所以用 hex_stripped 拼一个 ff 前缀。Hyprland 下这段不被读取（KWin 才读），
# 但保持格式正确，免得以后换 WM 或 KDE 工具校验时报错。

[ColorEffects:Disabled]
Color={{colors.surface_container.light.hex}}
ColorAmount=0.5
ColorEffect=3
ContrastAmount=0
ContrastEffect=0
IntensityAmount=0
IntensityEffect=0

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color={{colors.surface.light.hex}}
ColorAmount=0.025
ColorEffect=0
ContrastAmount=0.1
ContrastEffect=0
Enable=true
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate={{colors.surface_container_highest.light.hex}}
BackgroundNormal={{colors.surface_container_high.light.hex}}
DecorationFocus={{colors.primary.light.hex}}
DecorationHover={{colors.primary.light.hex}}
ForegroundActive={{colors.on_surface.light.hex}}
ForegroundInactive={{colors.on_surface_variant.light.hex}}
ForegroundLink={{colors.primary.light.hex}}
ForegroundNegative={{colors.error.light.hex}}
ForegroundNeutral={{colors.tertiary.light.hex}}
ForegroundNormal={{colors.on_surface.light.hex}}
ForegroundPositive={{colors.secondary.light.hex}}
ForegroundVisited={{colors.tertiary.light.hex}}

[Colors:Complementary]
BackgroundAlternate={{colors.surface_container_low.light.hex}}
BackgroundNormal={{colors.surface_container.light.hex}}
DecorationFocus={{colors.primary.light.hex}}
DecorationHover={{colors.primary.light.hex}}
ForegroundActive={{colors.on_surface.light.hex}}
ForegroundInactive={{colors.on_surface_variant.light.hex}}
ForegroundLink={{colors.primary.light.hex}}
ForegroundNegative={{colors.error.light.hex}}
ForegroundNeutral={{colors.tertiary.light.hex}}
ForegroundNormal={{colors.on_surface.light.hex}}
ForegroundPositive={{colors.secondary.light.hex}}
ForegroundVisited={{colors.tertiary.light.hex}}

[Colors:Header]
BackgroundAlternate={{colors.surface_container_high.light.hex}}
BackgroundNormal={{colors.surface_container.light.hex}}
DecorationFocus={{colors.primary.light.hex}}
DecorationHover={{colors.primary.light.hex}}
ForegroundActive={{colors.on_surface.light.hex}}
ForegroundInactive={{colors.on_surface_variant.light.hex}}
ForegroundLink={{colors.primary.light.hex}}
ForegroundNegative={{colors.error.light.hex}}
ForegroundNeutral={{colors.tertiary.light.hex}}
ForegroundNormal={{colors.on_surface.light.hex}}
ForegroundPositive={{colors.secondary.light.hex}}
ForegroundVisited={{colors.tertiary.light.hex}}

[Colors:Header][Inactive]
BackgroundAlternate={{colors.surface_container_high.light.hex}}
BackgroundNormal={{colors.surface_container.light.hex}}
DecorationFocus={{colors.primary.light.hex}}
DecorationHover={{colors.primary.light.hex}}
ForegroundActive={{colors.on_surface.light.hex}}
ForegroundInactive={{colors.on_surface_variant.light.hex}}
ForegroundLink={{colors.primary.light.hex}}
ForegroundNegative={{colors.error.light.hex}}
ForegroundNeutral={{colors.tertiary.light.hex}}
ForegroundNormal={{colors.on_surface.light.hex}}
ForegroundPositive={{colors.secondary.light.hex}}
ForegroundVisited={{colors.tertiary.light.hex}}

# 选中项：文件列表/菜单里高亮的那一行。
# 用 container 组而不是 primary 本身 —— 见文件头说明。
[Colors:Selection]
BackgroundAlternate={{colors.primary_container.light.hex}}
BackgroundNormal={{colors.primary_container.light.hex}}
DecorationFocus={{colors.primary.light.hex}}
DecorationHover={{colors.primary.light.hex}}
ForegroundActive={{colors.on_primary_container.light.hex}}
ForegroundInactive={{colors.on_primary_container.light.hex}}
ForegroundLink={{colors.on_primary_container.light.hex}}
ForegroundNegative={{colors.on_primary_container.light.hex}}
ForegroundNeutral={{colors.on_primary_container.light.hex}}
ForegroundNormal={{colors.on_primary_container.light.hex}}
ForegroundPositive={{colors.on_primary_container.light.hex}}
ForegroundVisited={{colors.on_primary_container.light.hex}}

[Colors:Tooltip]
BackgroundAlternate={{colors.surface_container_highest.light.hex}}
BackgroundNormal={{colors.surface_container_high.light.hex}}
DecorationFocus={{colors.primary.light.hex}}
DecorationHover={{colors.primary.light.hex}}
ForegroundActive={{colors.on_surface.light.hex}}
ForegroundInactive={{colors.on_surface_variant.light.hex}}
ForegroundLink={{colors.primary.light.hex}}
ForegroundNegative={{colors.error.light.hex}}
ForegroundNeutral={{colors.tertiary.light.hex}}
ForegroundNormal={{colors.on_surface.light.hex}}
ForegroundPositive={{colors.secondary.light.hex}}
ForegroundVisited={{colors.tertiary.light.hex}}

# 视图区（文件列表、文本编辑区）—— Dolphin 里最显眼的一段。
# 比 Window 更暗一档，形成"窗口底 < 内容区"的层次。
[Colors:View]
BackgroundAlternate={{colors.surface_container_low.light.hex}}
BackgroundNormal={{colors.surface.light.hex}}
DecorationFocus={{colors.primary.light.hex}}
DecorationHover={{colors.primary.light.hex}}
ForegroundActive={{colors.on_surface.light.hex}}
ForegroundInactive={{colors.on_surface_variant.light.hex}}
ForegroundLink={{colors.primary.light.hex}}
ForegroundNegative={{colors.error.light.hex}}
ForegroundNeutral={{colors.tertiary.light.hex}}
ForegroundNormal={{colors.on_surface.light.hex}}
ForegroundPositive={{colors.secondary.light.hex}}
ForegroundVisited={{colors.tertiary.light.hex}}

# 窗口底色 + 标题栏文字。只有这一段用 primary 当 ForegroundActive
# （跟随原 KDE 方案的惯例：窗口标题高亮时变色，其它段落不变）。
[Colors:Window]
BackgroundAlternate={{colors.surface_container_high.light.hex}}
BackgroundNormal={{colors.surface_container.light.hex}}
DecorationFocus={{colors.primary.light.hex}}
DecorationHover={{colors.primary.light.hex}}
ForegroundActive={{colors.primary.light.hex}}
ForegroundInactive={{colors.on_surface_variant.light.hex}}
ForegroundLink={{colors.primary.light.hex}}
ForegroundNegative={{colors.error.light.hex}}
ForegroundNeutral={{colors.tertiary.light.hex}}
ForegroundNormal={{colors.on_surface.light.hex}}
ForegroundPositive={{colors.secondary.light.hex}}
ForegroundVisited={{colors.tertiary.light.hex}}

[General]
ColorScheme=MaterialYouLight
Name=Material You Light
shadeSortColumn=true

[KDE]
contrast=4

# ARGB 格式：#ff + hex_stripped
[WM]
activeBackground=#ff{{colors.surface_container.light.hex_stripped}}
activeBlend={{colors.on_surface.light.red}},{{colors.on_surface.light.green}},{{colors.on_surface.light.blue}}
activeForeground=#ff{{colors.on_surface.light.hex_stripped}}
inactiveBackground=#ff{{colors.surface.light.hex_stripped}}
inactiveBlend={{colors.on_surface_variant.light.red}},{{colors.on_surface_variant.light.green}},{{colors.on_surface_variant.light.blue}}
inactiveForeground=#ff{{colors.on_surface_variant.light.hex_stripped}}
