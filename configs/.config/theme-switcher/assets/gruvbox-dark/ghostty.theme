# Gruvbox Dark —— 由 theme-switcher 管理
# ⚠ 改这个文件不生效（下次切主题会被覆盖）
#    要改请改 ~/.config/theme-switcher/assets/gruvbox-dark/ghostty.theme
#
# 翻译自同目录的 foot.ini（regular0-7 → palette 0-7，bright0-7 → palette 8-15）。
# 那份 foot.ini 里没有 selection-* / cursor= ，所以这里也没有 ——
# 这两类会落到 ~/.config/ghostty/config 里的值（那里设了 cursor-color）。
#
# ⚠ 本文件里不能写行尾注释（ghostty 会把整行丢掉，且完全静默）。

background = #282828
foreground = #ebdbb2
background-opacity = 0.85

# --- Normal colors (palette 0-7) ---
palette = 0=#282828
palette = 1=#cc241d
palette = 2=#98971a
palette = 3=#d79921
palette = 4=#458588
palette = 5=#b16286
palette = 6=#689d6a
palette = 7=#a89984

# --- Bright colors (palette 8-15) ---
palette = 8=#928374
palette = 9=#fb4934
palette = 10=#b8bb26
palette = 11=#fabd2f
palette = 12=#83a598
palette = 13=#d3869b
palette = 14=#8ec07c
palette = 15=#ebdbb2
