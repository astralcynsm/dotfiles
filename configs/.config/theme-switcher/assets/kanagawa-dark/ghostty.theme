# Kanagawa Dark —— 由 theme-switcher 管理
# ⚠ 改这个文件不生效（下次切主题会被覆盖）
#    要改请改 ~/.config/theme-switcher/assets/kanagawa-dark/ghostty.theme
#
# 翻译自同目录的 foot.ini（regular0-7 → palette 0-7，bright0-7 → palette 8-15）。
# 这是四套静态主题里唯一提供了 selection-* 和 cursor= 的，所以这两类也翻了过来：
#   foot 的 `cursor=1f1f28 e6e0c2` 是 <底色> <字色>，对应 ghostty 的
#   cursor-color + cursor-text 两个键。
#
# background-opacity 取 0.7 —— 与用户原先手工维护的
# ~/.config/ghostty/themes/dark 一致（那份就是 Kanagawa 的手工翻译）。
#
# ⚠ 本文件里不能写行尾注释（ghostty 会把整行丢掉，且完全静默）。

background = #1f1f28
foreground = #ddd8bb
background-opacity = 0.7

# 选中文本
selection-background = #49473e
selection-foreground = #ddd8bb

# 光标
cursor-color = #1f1f28
cursor-text = #e6e0c2

# --- Normal colors (palette 0-7) ---
palette = 0=#1f1f28
palette = 1=#e46a78
palette = 2=#98bc6d
palette = 3=#e5c283
palette = 4=#7eb3c9
palette = 5=#957fb8
palette = 6=#7eb3c9
palette = 7=#ddd8bb

# --- Bright colors (palette 8-15) ---
palette = 8=#8e8ead
palette = 9=#ec818c
palette = 10=#9ec967
palette = 11=#f1c982
palette = 12=#7bc2df
palette = 13=#a98fd2
palette = 14=#7bc2df
palette = 15=#a8a48d
