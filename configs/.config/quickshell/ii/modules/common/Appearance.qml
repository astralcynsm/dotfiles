    // 以下块原本全部硬编码，现已接到 Config.options.appearance（见 Config.qml 同名块）。
    // 用 ?. / ?? 兜底：Config 是 JsonObject，加载完成前 options 可能是空的，
    // 那时回退到与原硬编码值逐字相同的字面量，避免启动瞬间报错或闪一下。
    rounding: QtObject {
        // 全局圆角倍率。scale = 1 时下面每个表达式都退化成「基准值本身」，
        // 与参数化之前逐字一致（零变化）。scale 是只读的派生量，用户改的是 Config 里的那个。
        readonly property real scale: Config?.options.appearance.rounding?.scale ?? 1
        property int unsharpen: Math.round((Config?.options.appearance.rounding?.unsharpen ?? 2) * scale)
        property int unsharpenmore: Math.round((Config?.options.appearance.rounding?.unsharpenmore ?? 6) * scale)
        property int verysmall: Math.round((Config?.options.appearance.rounding?.verysmall ?? 8) * scale)
        property int small: Math.round((Config?.options.appearance.rounding?.small ?? 12) * scale)
        property int normal: Math.round((Config?.options.appearance.rounding?.normal ?? 17) * scale)
        property int large: Math.round((Config?.options.appearance.rounding?.large ?? 23) * scale)
        property int verylarge: Math.round((Config?.options.appearance.rounding?.verylarge ?? 30) * scale)
        // full 刻意不乘 scale：它是「圆形/胶囊」语义（头像遮罩、开关轨道、滑块手柄），
        // 9999 已经是「远超任何尺寸」的哨兵值，缩放它不会改变渲染结果，
        // 但会让「圆角全 0」的 preset 看起来像是要动它 —— 不如明确不动。
        property int full: Config?.options.appearance.rounding?.full ?? 9999
        property int screenRounding: large
        property int windowRounding: Math.round((Config?.options.appearance.rounding?.windowRounding ?? 18) * scale)
    }

