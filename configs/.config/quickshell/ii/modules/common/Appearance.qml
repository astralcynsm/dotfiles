        property real barHellaShortenScreenWidthThreshold: 1000 // Shorten even more...
        property real elevationMargin: Config?.options.appearance.sizes?.elevationMargin ?? 10
        property real fabShadowRadius: 5
        property real fabHoveredShadowRadius: 7
        // 本地改：原本硬编码 5，但本机 Hyprland 的 gaps_out 是 4（见 UserDecorations.lua），
        // 差 1px 会让 bar 开 Float(cornerStyle=1) 时比窗口边缘多缩进。现接到 Config。
        property real hyprlandGapsOut: Config?.options.appearance.sizes?.barGapsOut ?? 4
        property real mediaControlsWidth: Config?.options.appearance.sizes?.mediaControlsWidth ?? 440
        property real mediaControlsHeight: Config?.options.appearance.sizes?.mediaControlsHeight ?? 160
        property real notificationPopupWidth: Config?.options.appearance.sizes?.notificationPopupWidth ?? 410
        property real osdWidth: Config?.options.appearance.sizes?.osdWidth ?? 180
        property real searchWidthCollapsed: 210
        property real searchWidth: Config?.options.appearance.sizes?.searchWidth ?? 360
        property real sidebarWidth: Config?.options.appearance.sizes?.sidebarWidth ?? 460
        property real sidebarWidthExtended: Config?.options.appearance.sizes?.sidebarWidthExtended ?? 750
        property real baseVerticalBarWidth: 46
        property real verticalBarWidth: Config.options.bar.cornerStyle === 1 ? 
            (baseVerticalBarWidth + root.sizes.hyprlandGapsOut * 2) : baseVerticalBarWidth
        property real wallpaperSelectorWidth: 1200
        property real wallpaperSelectorHeight: 690
        property real wallpaperSelectorItemMargins: 8
        property real wallpaperSelectorItemPadding: 6
    }

